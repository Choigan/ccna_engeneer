{
  "name": "netlab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash -c \"$(curl -sL https://get.containerlab.dev)\"",
  "hostRequirements": {
    "cpus": 2
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "srl-labs.vscode-containerlab"
      ]
    }
  }
}
